// ─── SwipeCard ────────────────────────────────────────────────
function SwipeCard({ card, onSwipe }: SwipeCardProps): React.JSX.Element | null {
  const pan    = useRef(new Animated.ValueXY()).current;
  const wiggle = useRef(new Animated.Value(0)).current;
  const [gone, setGone] = useState(false);

  useEffect(() => {
    const t = setTimeout(() => {
      Animated.sequence([
        Animated.timing(wiggle, { toValue:  18, duration: 160, useNativeDriver: true }),
        Animated.timing(wiggle, { toValue: -18, duration: 160, useNativeDriver: true }),
        Animated.timing(wiggle, { toValue:  10, duration: 120, useNativeDriver: true }),
        Animated.timing(wiggle, { toValue:  -5, duration: 100, useNativeDriver: true }),
        Animated.timing(wiggle, { toValue:   0, duration:  80, useNativeDriver: true }),
      ]).start();
    }, 700);
    return () => clearTimeout(t);
  }, []);

  const panResponder = useRef(
    PanResponder.create({
      onMoveShouldSetPanResponder: (_, g) => Math.abs(g.dx) > 5,
      onPanResponderMove: Animated.event([null, { dx: pan.x, dy: pan.y }], { useNativeDriver: false }),
      onPanResponderRelease: (_, g) => {
        if (Math.abs(g.dx) > 80) {
          const dir = g.dx > 0 ? 1 : -1;
          Animated.timing(pan, {
            toValue: { x: dir * (SCREEN_WIDTH + 100), y: g.dy },
            duration: 300,
            useNativeDriver: true,
          }).start(() => {
            setGone(true);
            onSwipe(dir > 0 ? 'like' : 'nope');
          });
        } else {
          Animated.spring(pan, { toValue: { x: 0, y: 0 }, useNativeDriver: true }).start();
        }
      },
    })
  ).current;

  if (gone) return null;

  const rotate  = pan.x.interpolate({ inputRange: [-150, 150], outputRange: ['-8deg', '8deg'] });
  const likeOp  = pan.x.interpolate({ inputRange: [0,   80], outputRange: [0, 1], extrapolate: 'clamp' });
  const nopeOp  = pan.x.interpolate({ inputRange: [-80,  0], outputRange: [1, 0], extrapolate: 'clamp' });

  const imgSrc = card.isBase64
    ? { uri: `data:image/jpeg;base64,${card.img}` }
    : { uri: card.img };

  return (
    <Animated.View
      style={[s.swipeCard, { transform: [{ translateX: Animated.add(pan.x, wiggle) }, { translateY: pan.y }, { rotate }] }]}
      {...panResponder.panHandlers}
    >
      <Animated.View style={[s.stamp, s.stampLike, { opacity: likeOp }]}>
        <Text style={[s.stampText, { color: '#3aaa72', borderColor: '#3aaa72' }]}>LIKE</Text>
      </Animated.View>
      <Animated.View style={[s.stamp, s.stampNope, { opacity: nopeOp }]}>
        <Text style={[s.stampText, { color: C.primary, borderColor: C.primary }]}>NOPE</Text>
      </Animated.View>

      <View style={{ height: 220, overflow: 'hidden' }}>
        <Image source={imgSrc} style={{ width: '100%', height: '100%' }} resizeMode="cover" />
        <View style={s.photoTag}>
          <Text style={s.photoTagText}>Photo from Google</Text>
        </View>
        <View style={s.swipeHint}>
          <Text style={s.swipeHintText}>← swipe →</Text>
        </View>
      </View>

      <View style={{ paddingHorizontal: 16, paddingTop: 14, paddingBottom: 8 }}>
        <Text style={s.cardName}>{card.name}</Text>
        <Text style={s.cardPrice}>{card.price}</Text>
      </View>
      <View style={s.whyBox}>
        <Text style={s.whyLabel}>WHY FOR YOU?</Text>
        <Text style={s.whyText}>{card.why}</Text>
      </View>
    </Animated.View>
  );
}

// ─── SwipeMatch ───────────────────────────────────────────────
function SwipeMatch({ onNext, onBack }: ScreenProps): React.JSX.Element {
  const [cards, setCards] = useState<RestaurantCard[]>(RESTAURANT_CARDS);
  const deck = cards.length === 0 ? RESTAURANT_CARDS : cards;

  const handleSwipe = (_dir: 'like' | 'nope'): void => {
    setCards(prev => {
      const next = prev.slice(1);
      return next.length === 0 ? RESTAURANT_CARDS : next;
    });
  };

  return (
    <View style={[s.screen, { backgroundColor: '#fff' }]}>
      <View style={{ paddingHorizontal: 20, paddingTop: 16 }}>
        <View style={{ height: 420, position: 'relative' }}>
          {[...deck].reverse().map((card, i) => {
            const idx   = deck.length - 1 - i;
            const isTop = idx === 0;
            const scale = 1 - (deck.length - 1 - idx) * 0.035;
            const ty    = (deck.length - 1 - idx) * 7;

            if (isTop) {
              return <SwipeCard key={card.name} card={card} onSwipe={handleSwipe} />;
            }
            return (
              <View
                key={card.name + i}
                style={[StyleSheet.absoluteFillObject, { transform: [{ scale }, { translateY: -ty }], zIndex: 0 }]}
              >
                <View style={s.backCard}>
                  <Image
                    source={card.isBase64 ? { uri: `data:image/jpeg;base64,${card.img}` } : { uri: card.img }}
                    style={{ width: '100%', height: 220 }}
                    resizeMode="cover"
                  />
                  <View style={{ padding: 14 }}>
                    <Text style={s.cardName}>{card.name}</Text>
                    <Text style={s.cardPrice}>{card.price}</Text>
                  </View>
                </View>
              </View>
            );
          })}
        </View>

        <View style={s.actionBtns}>
          <TouchableOpacity onPress={() => handleSwipe('nope')} style={s.btnNope}>
            <Text style={{ fontSize: 20, color: C.primary }}>✕</Text>
          </TouchableOpacity>
          <TouchableOpacity onPress={() => handleSwipe('like')} style={s.btnLike}>
            <Text style={{ fontSize: 20, color: '#fff' }}>♥</Text>
          </TouchableOpacity>
        </View>
      </View>

      <View style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={s.swiperSlogan}>
          Swipe. Match. <Text style={{ color: C.primary }}>Eat.</Text>
        </Text>
      </View>

      <NavRow onBack={onBack} onNext={onNext} step={1} />
    </View>
  );
}

// ─── GroupDecision ────────────────────────────────────────────
function GroupDecision({ onNext, onBack }: ScreenProps): React.JSX.Element {
  const AVTS: AvatarItem[] = [
    { initials: 'Y', color: C.primary, top:  10, left:  10 },
    { initials: 'M', color: '#3aaa72', top:   8, right: 10 },
    { initials: 'J', color: C.primary, bottom: 0, left:  0 },
