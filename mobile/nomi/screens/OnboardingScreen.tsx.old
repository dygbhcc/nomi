  ];

  return (
    <View style={[s.screen, { backgroundColor: C.bg }]}>
      <View style={{ flex: 1, alignItems: 'center', justifyContent: 'center', paddingHorizontal: 32 }}>
        <View style={{ width: 240, height: 160, position: 'relative', marginBottom: 36 }}>
          <View style={s.winnerCard}>
            <Text style={{ fontSize: 28 }}>🏆</Text>
            <Text style={s.winnerName}>Tasca do Chico</Text>
            <Text style={s.winnerVotes}>3 votes ✓</Text>
          </View>
          {AVTS.map((a, i) => (
            <View
              key={i}
              style={[
                s.avatar,
                {
                  backgroundColor: a.color,
                  ...(a.top    !== undefined && { top:    a.top    }),
                  ...(a.bottom !== undefined && { bottom: a.bottom }),
                  ...(a.left   !== undefined && { left:   a.left   }),
                  ...(a.right  !== undefined && { right:  a.right  }),
                },
              ]}
            >
              <Text style={{ color: '#fff', fontWeight: '800', fontSize: 16 }}>{a.initials}</Text>
              <View style={s.avatarBadge}>
                <Text style={{ fontSize: 8 }}>{i === 1 ? '⬆' : '♥'}</Text>
              </View>
            </View>
          ))}
        </View>

        <Text style={s.valueTitle}>
          One room.{'\n'}
          <Text style={{ color: C.primary }}>Everyone in.</Text>
        </Text>
        <Text style={s.valueSubtitle}>Share a link. Vote together. nomi picks the winner.</Text>
      </View>
      <NavRow onBack={onBack} onNext={onNext} step={2} />
    </View>
  );
}

// ─── CTA ──────────────────────────────────────────────────────
function CTA({ onBack }: Pick<ScreenProps, 'onBack'>): React.JSX.Element {
  const [email, setEmail] = useState('');
  const [done,  setDone ] = useState(false);

  return (
    <View style={[s.screen, { backgroundColor: C.bg }]}>
      <ScrollView contentContainerStyle={{ flexGrow: 1, padding: 28 }}>
        <View style={{ flex: 1, justifyContent: 'center' }}>
          <Text style={s.ctaTitle}>
            ready for{'\n'}
            <Text style={{ color: C.primary }}>something good?</Text>
          </Text>

          {!done ? (
            <>
              <TextInput
                placeholder="your@email.com"
                placeholderTextColor={C.muted}
                value={email}
                onChangeText={setEmail}
                keyboardType="email-address"
                autoCapitalize="none"
                style={[s.input, email.length > 0 && { borderColor: C.primary }]}
              />
              <TouchableOpacity
                onPress={() => email.length > 0 && setDone(true)}
                style={[s.primaryBtn, email.length === 0 && { backgroundColor: '#DDD5D0' }]}
              >
                <Text style={s.primaryBtnText}>Let's eat →</Text>
              </TouchableOpacity>

              <View style={s.divider}>
                <View style={s.dividerLine} />
                <Text style={[s.dividerText, { marginHorizontal: 12 }]}>or</Text>
                <View style={s.dividerLine} />
              </View>

              <TouchableOpacity style={s.googleBtn}>
                <Text style={s.googleBtnText}>🇬  Continue with Google</Text>
              </TouchableOpacity>

              <TouchableOpacity style={{ marginTop: 12, alignItems: 'center' }}>
                <Text style={{ color: C.muted, fontSize: 14 }}>Continue as guest</Text>
              </TouchableOpacity>
            </>
          ) : (
            <View style={s.successBox}>
              <Text style={{ fontSize: 48, marginBottom: 16 }}>🎉</Text>
              <Text style={s.successTitle}>You're in!</Text>
              <Text style={s.successSub}>Welcome to nomi. Your next great dinner is one swipe away.</Text>
            </View>
          )}
        </View>
        <Text style={s.terms}>By continuing, you agree to nomi's Terms & Privacy Policy.</Text>
      </ScrollView>
      <View style={s.navRow}>
        <TouchableOpacity onPress={onBack} style={s.navBack}>
          <Text style={s.navBackText}>← Back</Text>
        </TouchableOpacity>
      </View>
    </View>
  );
}

// ─── Main ─────────────────────────────────────────────────────
type Screen = 'splash' | 'value1' | 'swipe' | 'group' | 'cta';
const SCREENS: Screen[] = ['splash', 'value1', 'swipe', 'group', 'cta'];

export default function OnboardingScreen({ onDone }: Props): React.JSX.Element {
  const [step, setStep] = useState(0);

  const go = (delta: number): void => {
    const next = step + delta;
    if (next >= SCREENS.length) {
      onDone();
      return;
    }
    setStep(Math.max(0, next));
  };

  return (
    <View style={{ flex: 1 }}>
      {step === 0 && <Splash  onNext={() => go(1)} />}
      {step === 1 && <Value1  onNext={() => go(1)} onBack={() => go(-1)} />}
      {step === 2 && <SwipeMatch onNext={() => go(1)} onBack={() => go(-1)} />}
      {step === 3 && <GroupDecision onNext={() => go(1)} onBack={() => go(-1)} />}
      {step === 4 && <CTA    onBack={() => go(-1)} />}
    </View>
  );
}

