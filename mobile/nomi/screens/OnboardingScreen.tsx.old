  cardName:       { fontSize: 18, fontWeight: '700', color: C.text, marginBottom: 2 },
  cardPrice:      { fontSize: 14, color: C.muted },
  whyBox:         { marginHorizontal: 16, marginBottom: 16, marginTop: 4, backgroundColor: 'rgba(224,106,79,0.07)', borderRadius: 12, padding: 12 },
