import React, { useState, useRef, useEffect } from 'react';
import {
  View, Text, Image, TouchableOpacity, ScrollView,
  Animated, PanResponder, Dimensions, StyleSheet,
  TextInput, Platform, ViewStyle,
} from 'react-native';

type Props = {
  onDone: () => void;
};

interface RestaurantCard {
  name: string;
  price: string;
  why: string;
  img: string;
  isBase64: boolean;
}

interface FoodItem {
  img: string;
  top?: number | `${number}%`;
  bottom?: number | `${number}%`;
  left?: number | `${number}%`;
  right?: number | `${number}%`;
  size: number;
}

interface AvatarItem {
  initials: string;
  color: string;
  top?: number;
  bottom?: number;
  left?: number;
  right?: number;
}

interface NavRowProps {
  onBack: () => void;
  onNext: () => void;
  step: number;
  totalSteps?: number;
}

interface ScreenProps {
  onNext: () => void;
  onBack: () => void;
}

interface SwipeCardProps {
  card: RestaurantCard;
  onSwipe: (dir: 'like' | 'nope') => void;
}

