  { img: 'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=200&h=200&fit=crop', top: '52%', left:   '6%', size: 64 },
  { img: 'https://images.unsplash.com/photo-1579584425555-c3ce17fd4351?w=200&h=200&fit=crop', top: '50%', right:  '8%', size: 72 },
];

// ─── Helpers ──────────────────────────────────────────────────
function shadow(depth: number = 1): ViewStyle {
  return {
    shadowColor: '#000',
    shadowOffset: { width: 0, height: depth * 4 },
    shadowOpacity: 0.10 + depth * 0.03,
    shadowRadius: depth * 8,
    elevation: depth * 3,
  };
}

// ─── FloatingFood ─────────────────────────────────────────────
function FloatingFood(): React.JSX.Element {
  const anims = useRef<Animated.Value[]>(FOOD_ITEMS.map(() => new Animated.Value(0))).current;

  useEffect(() => {
    anims.forEach((anim, i) => {
      Animated.loop(
        Animated.sequence([
          Animated.timing(anim, { toValue: 1, duration: 2800 + i * 400, useNativeDriver: true }),
          Animated.timing(anim, { toValue: 0, duration: 2800 + i * 400, useNativeDriver: true }),
        ])
      ).start();
    });
  }, []);

  return (
    <View style={StyleSheet.absoluteFillObject} pointerEvents="none">
      {FOOD_ITEMS.map((item, i) => {
        const translateY = anims[i].interpolate({ inputRange: [0, 1], outputRange: [0, -12] });
        const rotate     = anims[i].interpolate({ inputRange: [0, 1], outputRange: ['-4deg', '4deg'] });
        const posStyle = {
          position: 'absolute' as const,
          ...(item.top    !== undefined && { top:    item.top    }),
          ...(item.bottom !== undefined && { bottom: item.bottom }),
          ...(item.left   !== undefined && { left:   item.left   }),
          ...(item.right  !== undefined && { right:  item.right  }),
        };
        return (
          <Animated.Image
            key={i}
            source={{ uri: item.img }}
            style={[posStyle as any, {
              width: item.size,
              height: item.size,
              transform: [{ translateY }, { rotate }]
            }]}
          />
        );
      })}
    </View>
  );
}

// ─── NavRow ───────────────────────────────────────────────────
function NavRow({ onBack, onNext, step, totalSteps = 4 }: NavRowProps): React.JSX.Element {
  return (
    <View style={s.navRow}>
      <TouchableOpacity onPress={onBack} style={s.navBack}>
        <Text style={s.navBackText}>← Back</Text>
      </TouchableOpacity>
      <View style={s.dots}>
        {Array.from({ length: totalSteps }).map((_, i) => (
          <View key={i} style={[s.dot, i === step && s.dotActive]} />
        ))}
      </View>
      <TouchableOpacity onPress={onNext} style={s.navNext}>
        <Text style={s.navNextText}>Next →</Text>
      </TouchableOpacity>
    </View>
  );
}

