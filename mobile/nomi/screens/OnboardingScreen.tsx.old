  { img: 'https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=200&h=200&fit=crop', top: '10%', left:  '12%', size: 76 },
  { img: 'https://images.unsplash.com/photo-1569718212165-3a8278d5f624?w=200&h=200&fit=crop', top:  '6%', right: '10%', size: 68 },
