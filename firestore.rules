rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All client reads and writes go through Cloud Functions (Admin SDK
    // bypasses these rules). The only direct access left is the read-only
    // realtime room listener used during group voting, and restaurant reads
    // used to synchronize the shared voting list across participants.
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Restaurants are public catalogue data — reads allowed, writes blocked.
    match /restaurants/{restaurantId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Deny everything else ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
