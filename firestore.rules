rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Public read, admin-only writes
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users can only write their own profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Base room docs are readable by signed-in users, mutable by organizer/admin
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.organizer_uid || isAdmin()
      );
    }

    // Users can only write their own room preferences
    match /rooms/{roomId}/preferences/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Cache metadata for region queries (Cloud Functions/admin only write)
    match /restaurant_cache_regions/{regionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
