rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All client reads and writes go through Cloud Functions (Admin SDK
    // bypasses these rules). The only direct access left is the read-only
    // realtime room listener used during group voting.
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Deny everything else ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
