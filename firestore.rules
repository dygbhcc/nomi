rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isRoomParticipant(roomData) {
      return isAuthenticated() && roomData.participants[request.auth.uid] != null;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow create: if isAuthenticated() && request.resource.data.participants[request.auth.uid] != null;
      allow read, update, delete: if isRoomParticipant(resource.data);
    }

    match /rooms/{roomId}/preferences/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /votes/{roomId}/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}