{
  "rules": {
    "votes": {
      "$roomId": {
        "$userId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $userId"
        }
      }
    },
    "occupancy": {
      "$restaurantId": {
        "live": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    }
  }
}
