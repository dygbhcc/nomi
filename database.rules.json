{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        "final_votes": {
          "$userId": {
            ".write": "auth != null && auth.uid === $userId"
          }
        },
        "preference_votes": {
          "$userId": {
            ".write": "auth != null && auth.uid === $userId"
          }
        },
        "event": {
          ".write": "auth != null"
        }
      }
    },

    "room_state": {
      "$roomId": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
