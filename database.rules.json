{
  "rules": {
    "active_votes": {
      "$roomId": {
        ".read": "auth != null && auth.provider !== 'anonymous'",
        "$userId": {
          ".write": "auth != null && auth.provider !== 'anonymous' && auth.uid === $userId"
        }
      }
    },

    "room_state": {
      "$roomId": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "typing_indicators": {
      "$roomId": {
        ".read": "auth != null",
        "$userId": {
          ".write": "auth != null && auth.uid === $userId"
        }
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
